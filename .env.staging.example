# WASIT BUSINESS GLOBAL — Staging environment template.
#
# Copy to `.env.staging` (git-ignored) and fill the secrets. Compose loads it
# with `--env-file .env.staging`. Nothing here is a real credential; the file is
# tracked only as documentation.
#
# Generate the secrets locally, never reuse production values:
#   JWT_SECRET=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)

# --- Environment identity -----------------------------------------------------
# `staging` (not production) so the app knows it is a pre-production surface.
NODE_ENV=staging

# --- Database (the `db` service in compose) -----------------------------------
POSTGRES_USER=wasit
POSTGRES_PASSWORD=replace-with-a-long-random-staging-password
POSTGRES_DB=wasit_staging

# --- Secrets (required, no default) -------------------------------------------
# Must be >=32 chars and must NOT be the committed development default; the API
# refuses to boot in staging otherwise.
JWT_SECRET=replace-with-a-long-random-staging-secret-at-least-32-chars

# --- Public URLs --------------------------------------------------------------
# Over plain HTTP on localhost keep http://; the session cookie's `Secure` flag
# follows this scheme. For an HTTPS staging host use https:// here.
APP_URL=http://localhost:8080
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# --- Payments (no real money in staging) --------------------------------------
PAYMENT_PROVIDER=noop
PAYMENT_WEBHOOK_SECRET=

# --- Mail / SMS (log transports: no external provider needed) -----------------
MAIL_TRANSPORT=log
SMS_TRANSPORT=log

# --- Rate limiting: shared counters, single instance is fine either way -------
RATE_LIMIT_STORE=memory

# --- Observability ------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=
OBS_LOG_FORMAT=json
OBS_ALERTS_ENABLED=true
OBS_ALERT_NOTIFY=log

# --- QA-only escape hatch -----------------------------------------------------
# The mail/SMS transports here are `log`, which redacts the body, so no reachable
# link/code would be produced. This re-enables the dev-only token-surfacing
# routes on the staging stack so manual QA can finish verification/reset. It is
# staging-only and must never be set with real user data or in production (the
# API refuses to boot in production with it true).
ALLOW_DEV_TOOLING=true

# --- Read cache ---------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
