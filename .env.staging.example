# WASIT BUSINESS GLOBAL — Staging environment template.
#
# Copy to `.env.staging` (git-ignored) and fill the secrets. Compose loads it
# with `--env-file .env.staging`. Nothing here is a real credential; the file is
# tracked only as documentation.
#
# Generate the secrets locally, never reuse production values:
#   JWT_SECRET=$(openssl rand -hex 32)
#   POSTGRES_PASSWORD=$(openssl rand -hex 24)

# --- Environment identity -----------------------------------------------------
# `staging` (not production) so the app knows it is a pre-production surface.
NODE_ENV=staging

# --- Database (the `db` service in compose) -----------------------------------
POSTGRES_USER=wasit
POSTGRES_PASSWORD=replace-with-a-long-random-staging-password
POSTGRES_DB=wasit_staging

# --- Secrets (required, no default) -------------------------------------------
# Must be >=32 chars and must NOT be the committed development default; the API
# refuses to boot in staging or production otherwise (this is JWT_SECRET's own
# guard, independent of ALLOW_DEV_TOOLING below).
JWT_SECRET=replace-with-a-long-random-staging-secret-at-least-32-chars

# --- Public URLs --------------------------------------------------------------
# Over plain HTTP on localhost keep http://; the session cookie's `Secure` flag
# follows this scheme. For an HTTPS staging host use https:// here.
APP_URL=http://localhost:8080
API_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
WEB_PORT=8080

# --- AI (optional: no cost until a provider is enabled) -----------------------
# AI_PROVIDER: none | local-heuristic | openai | anthropic | noop
#   · none / local-heuristic = the real local analysis engine (no cost, no key).
#   · openai / anthropic     = external provider (requires AI_API_KEY).
AI_PROVIDER=none
# Optional deployment-wide model override. When empty, the router applies the
# capability policy, then AI_DEFAULT_MODEL. Value is the *vendor* model name
# (e.g. gpt-4o-mini), not the catalogue key (openai-gpt-4o-mini).
AI_MODEL=
AI_DEFAULT_MODEL=openai-gpt-4o-mini
AI_API_KEY=
# Hard ceiling on a single outbound provider call, in milliseconds.
AI_REQUEST_TIMEOUT_MS=30000

# --- Payments (no real money in staging) --------------------------------------
PAYMENT_PROVIDER=noop
PAYMENT_WEBHOOK_SECRET=

# --- Mail / SMS (log transports: no external provider needed) -----------------
MAIL_TRANSPORT=log
SMS_TRANSPORT=log

# --- Backup freshness ---------------------------------------------------------
# The `backup` compose service writes this heartbeat after each successful run;
# the API reads it (read-only) and the `backup_stale` alert rule fires when it
# goes stale. BACKUP_MAX_AGE_HOURS must exceed BACKUP_INTERVAL_SECONDS / 3600.
BACKUP_HEARTBEAT_FILE=/backups/.last-success.json
BACKUP_MAX_AGE_HOURS=26
BACKUP_RETENTION_COUNT=7
BACKUP_INTERVAL_SECONDS=86400

# --- Rate limiting: shared counters, single instance is fine either way -------
RATE_LIMIT_STORE=memory

# --- Observability ------------------------------------------------------------
METRICS_ENABLED=true
METRICS_TOKEN=
OBS_LOG_FORMAT=json
OBS_ALERTS_ENABLED=true
OBS_ALERT_NOTIFY=log

# --- QA-only escape hatch -----------------------------------------------------
# The mail/SMS transports here are `log`, which redacts the body, so no reachable
# link/code would be produced. This re-enables the dev-only token-surfacing
# routes on the staging stack so manual QA can finish verification/reset. It is
# staging-only; the API refuses to boot in production with it true. Enabling it
# lets anyone who can reach this stack mint verification links, phone codes and
# reset tokens for any address, so never enable it with real user data.
#
# NOTE: this is a *separate* guard from JWT_SECRET. The committed development
# JWT_SECRET is refused at boot in staging *and* production unconditionally (see
# the "Secrets" section above) — it is not affected by ALLOW_DEV_TOOLING.
ALLOW_DEV_TOOLING=true

# --- Read cache ---------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=60
