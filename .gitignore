node_modules/
dist/
dist-bundle/
build/
.env
.env.local
*.log
.DS_Store
coverage/
.turbo/
*.zip
*.tsbuildinfo
# Local database backups — contain role password hashes / data; never commit.
backups/
# Playwright E2E artifacts — session cookies + failure output must never be committed.
test-results/
logs/
vendor/piper/
packages/server/vendor/
playwright-report/
e2e/.auth/
# Scratch backup heartbeat written by the E2E run
.e2e/

# Local private media storage (generated marketing videos) — never committed
.wasit-media/
.wasit-media-demo/
packages/server/.wasit-media/
.wasit-media-test/
packages/server/.wasit-media-test/

# Staging env with real secrets — never commit.
.env.staging
# Public-demo env with real secrets — never commit.
.env.demo
.env.demo.*
# Local functional-audit stack env — never commit.
.env.e2e-local
# Generated by scripts/staging-smoke.sh (random secrets); the .failed copy is
# kept on a failed run for inspection. Neither must ever be committed.
.env.staging.smoke
.env.staging.smoke.failed

# Local media scratch from functional audit — never commit.
.wasit-media-local

# Rendered marketing videos + verification reports are build output, not source.
packages/server/artifacts/

# Pidfiles and logs from scripts/demo-up.sh
.demo-run/

# Local E2E harness runs (API/web logs, screenshots)
.entity-run/

# Git bundles are hand-off artifacts, not source
*.bundle
*.bundle.sha256
