node_modules/
dist/
dist-bundle/
build/
.env
.env.local
*.log
.DS_Store
coverage/
.turbo/
*.zip
*.tsbuildinfo
# Local database backups — contain role password hashes / data; never commit.
backups/
# Playwright E2E artifacts — session cookies + failure output must never be committed.
test-results/
playwright-report/
e2e/.auth/
# Scratch backup heartbeat written by the E2E run
.e2e/

# Local private media storage (generated marketing videos) — never committed
.wasit-media/
packages/server/.wasit-media/

# Staging env with real secrets — never commit.
.env.staging
# Generated by scripts/staging-smoke.sh (random secrets); the .failed copy is
# kept on a failed run for inspection. Neither must ever be committed.
.env.staging.smoke
.env.staging.smoke.failed
