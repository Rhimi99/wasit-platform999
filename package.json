{
  "name": "wasit-business-global",
  "version": "0.1.0",
  "private": true,
  "description": "WASIT BUSINESS GLOBAL - Global trade intermediary platform",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wasit/server",
    "build": "npm run build -w @wasit/server",
    "build:prod": "npm run build:prod -w @wasit/server",
    "typecheck": "npm run typecheck -w @wasit/server && npm run typecheck -w @wasit/web",
    "test": "npm run test -w @wasit/server",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @wasit/server",
    "db:migrate": "npm run db:migrate -w @wasit/server",
    "db:seed": "npm run db:seed -w @wasit/server",
    "bootstrap:super-admin": "npm run bootstrap:super-admin -w @wasit/server",
    "web": "npm run dev -w @wasit/web"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
