{
  "name": "wasit-business-global",
  "version": "0.1.0",
  "private": true,
  "description": "WASIT BUSINESS GLOBAL - Global trade intermediary platform",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @wasit/server",
    "build": "npm run build -w @wasit/server",
    "build:prod": "npm run build:prod -w @wasit/server",
    "typecheck": "npm run typecheck -w @wasit/server && npm run typecheck -w @wasit/web",
    "test": "npm run test -w @wasit/server",
    "test:e2e": "playwright test",
    "db:generate": "npm run db:generate -w @wasit/server",
    "db:migrate": "npm run db:migrate -w @wasit/server",
    "db:seed": "npm run db:seed -w @wasit/server",
    "bootstrap:super-admin": "npm run bootstrap:super-admin -w @wasit/server",
    "web": "npm run dev -w @wasit/web",
    "media:setup": "node scripts/setup-ffmpeg-static.mjs",
    "voices:setup": "bash scripts/install-tts.sh",
    "voices:check": "bash scripts/install-tts.sh --check",
    "session": "bash scripts/session/session",
    "session:start": "bash scripts/session/session-start.sh",
    "session:checkpoint": "bash scripts/session/session-checkpoint.sh",
    "session:close": "bash scripts/session/session-close.sh",
    "session:status": "bash scripts/session/session-status.sh",
    "session:recovery": "bash scripts/session/session-recovery.sh",
    "session:backup": "bash scripts/session/session-backup.sh",
    "session:selftest": "bash scripts/session/session-selftest.sh"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0"
  }
}
