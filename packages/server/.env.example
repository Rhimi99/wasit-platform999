# WASIT BUSINESS GLOBAL — Server Environment Template
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك — لا ترفع القيم الحقيقية لأي مستودع.

# Node
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://wasit:wasit_dev_password@localhost:5432/wasit_dev

# Security
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Rate limiting (requests per window — raise for tests/CI)
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=15
# Where counters live: `memory` (single instance) or `postgres` (shared across
# instances, survives restarts — required when running more than one API).
RATE_LIMIT_STORE=memory
# How often the scheduler removes expired rate-limit buckets, in minutes.
RATE_LIMIT_PURGE_INTERVAL_MINUTES=15

# App URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# AI (اختياري — لا تكلفة حتى تفعيل مزود)
AI_PROVIDER=noop
AI_MODEL=
AI_API_KEY=

# Payments — يُفعَّل مزوّد واحد فقط عبر PAYMENT_PROVIDER.
# القيم: noop | manual | open-checkout | flouci | clictopay
# لا تضع أي مفاتيح حقيقية هنا — القيم الحقيقية عبر Secrets/Environment فقط.
PAYMENT_PROVIDER=noop
# HMAC secret لتوقيع/تحقق webhooks الخاصة بـmanual/open-checkout فقط
# (Flouci وClicToPay لا يوثّقان توقيعًا — يُتحقق من الحالة مباشرة من المزوّد).
PAYMENT_WEBHOOK_SECRET=

# Flouci Payment Gateway (https://docs.flouci.com)
# مفاتيح TEST APP متاحة فورًا بعد رفع RNE؛ مفاتيح الإنتاج بعد KYB.
# المبالغ تُرسل بالمليم (minor units). المفاتيح تُقرأ من البيئة فقط.
FLOUCI_BASE_URL=https://developers.flouci.com
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=

# ClicToPay (SPS Monétique Tunisie)
# الـhost والاعتمادات تُمنح من SPS/البنك.
# sandbox: https://test.clictopay.com/payment/rest
# production: https://ipay.clictopay.com/payment/rest
CLICTOPAY_BASE_URL=https://test.clictopay.com/payment/rest
CLICTOPAY_USERNAME=
CLICTOPAY_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173

# Scheduler (in-process background jobs) — off by default.
# Enables subscription auto-renew rollover. Idempotent across workers, so it is
# safe if hit by both the scheduler and the admin route, or by two instances.
# Leave false in tests/one-off commands.
SCHEDULER_ENABLED=false
SUBSCRIPTION_ROLLOVER_INTERVAL_MINUTES=60

# Dev-only token-surfacing routes (verification links, phone codes, reset
# tokens, TOTP). On automatically in development/test. A deployed environment
# must opt in explicitly, and only for pre-production QA: enabling it lets
# anyone who can reach the API mint tokens for any address. Refused in
# production regardless of this value.
ALLOW_DEV_TOOLING=false

# Observability (C2). Structured JSON logs go to stdout for the platform's log
# collector; `pretty` is for reading along in a terminal. The in-process buffer
# behind the admin logs route only holds records at or above OBS_LOG_LEVEL.
OBS_LOG_LEVEL=info
OBS_LOG_FORMAT=json
# Alert rule evaluation. Needs the scheduler enabled to run on an interval; it
# can also be triggered from the admin route. `log` notifier always works;
# `webhook` POSTs to OBS_ALERT_WEBHOOK_URL (Slack/PagerDuty bridge).
OBS_ALERTS_ENABLED=false
OBS_ALERT_INTERVAL_MINUTES=5
OBS_ALERT_NOTIFY=log
OBS_ALERT_WEBHOOK_URL=
OBS_ALERT_WEBHOOK_TOKEN=
# Prometheus scrape endpoint at /metrics. Set METRICS_TOKEN to require a bearer
# token; otherwise restrict the endpoint to the scraping network.
METRICS_ENABLED=true
METRICS_TOKEN=

# Read cache for hot, rarely-changing reference reads (geo catalogue,
# categories, SEO sitemap). Disabled by default: with it off every read hits the
# source, which is what tests and one-off commands want. Enable in a deployment
# to absorb repeat reads; a write invalidates the namespace it changed, so the
# TTL is only an upper bound on how long an *unwritten* change can lag.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500

# Mail (transactional email: email verification, password reset).
# `log` = no-network fallback for local dev/CI (a redacted line is printed and a
# MAIL.SENT audit row is written). `smtp` = real delivery.
# Credentials come only from the environment; never commit them.
MAIL_TRANSPORT=log
MAIL_FROM=WASIT BUSINESS GLOBAL <no-reply@wasit.tn>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMS (phone verification). `log` = no-network fallback for dev/CI; `http` posts
# a JSON body to a gateway. Field names are configurable for the common
# `{ to, text }` providers; auth scheme may be none/bearer/basic.
SMS_TRANSPORT=log
SMS_SENDER=WASIT
SMS_HTTP_URL=
SMS_HTTP_AUTH_SCHEME=none
SMS_HTTP_TOKEN=
SMS_HTTP_USERNAME=
SMS_HTTP_PASSWORD=
SMS_HTTP_TO_FIELD=to
SMS_HTTP_TEXT_FIELD=text
SMS_HTTP_SENDER_FIELD=from
PHONE_VERIFY_TTL_MINUTES=10
PHONE_VERIFY_MAX_ATTEMPTS=5
# Media storage (marketing videos, generated assets). Assets are private: they
# are written to storage under opaque keys and served only via signed,
# short-lived API links — never as static files. `local` is the on-disk driver.
MEDIA_STORAGE=local
MEDIA_STORAGE_DIR=.wasit-media
# Public origin used to build preview URLs in JSON responses (empty = relative).
PUBLIC_API_URL=
# Marketing video renderer. `structural` = real local MP4 render via
# ffmpeg-static + libass (Arabic shaping supported). `noop` fails loudly.
VIDEO_PROVIDER=structural
VIDEO_FFMPEG_PATH=
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=25
VIDEO_FONT=DejaVu Sans
VIDEO_ARABIC_FONT=Noto Sans Arabic
VIDEO_FONTS_DIR=
MEDIA_DOWNLOAD_TTL_SECONDS=900
MEDIA_MAX_VIDEO_BYTES=52428800
