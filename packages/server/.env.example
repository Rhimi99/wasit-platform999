# WASIT BUSINESS GLOBAL — Server Environment Template
# انسخ هذا الملف إلى .env وعدّل القيم حسب بيئتك — لا ترفع القيم الحقيقية لأي مستودع.

# Node
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://wasit:wasit_dev_password@localhost:5432/wasit_dev

# Security
JWT_SECRET=replace-with-a-long-random-secret
SESSION_SECRET=replace-with-a-long-random-secret

# Rate limiting (requests per window — raise for tests/CI)
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=15
# Account lockout (LC-07): after MAX_LOGIN_ATTEMPTS consecutive wrong passwords
# the account is locked for LOCKOUT_MINUTES, then unlocks automatically. The
# streak resets on a successful login. Keep MAX_LOGIN_ATTEMPTS well below
# RATE_LIMIT_LOGIN_MAX so the per-account lock engages before the per-IP limit.
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Where counters live: `memory` (single instance) or `postgres` (shared across
# instances, survives restarts — required when running more than one API).
RATE_LIMIT_STORE=memory
# How often the scheduler removes expired rate-limit buckets, in minutes.
RATE_LIMIT_PURGE_INTERVAL_MINUTES=15
# API resource protection (011.4). A general per-subject backstop over /api/*
# (subject = authenticated user, else trusted client IP), plus tighter limits on
# the expensive surfaces. `/api/auth` and `/api/health` are exempt from the
# general limit. These are ADDITIONS to RBAC/auth — never replacements.
# General /api/* backstop (requests per window). Generous by design.
RATE_LIMIT_API_MAX=300
RATE_LIMIT_API_WINDOW_SECONDS=60
# AI endpoints (/api/ai/*): a tight per-user limit plus a per-IP backstop.
RATE_LIMIT_AI_MAX=60
RATE_LIMIT_AI_WINDOW_SECONDS=60
RATE_LIMIT_AI_IP_MAX=300
# Public search (/api/search/*), limited per trusted client IP.
RATE_LIMIT_SEARCH_MAX=120
RATE_LIMIT_SEARCH_WINDOW_SECONDS=60
# Marketing-video generation (synchronous ffmpeg render), per user.
RATE_LIMIT_VIDEO_MAX=6
RATE_LIMIT_VIDEO_WINDOW_SECONDS=60
# Application-level request body cap, in bytes. A larger body is refused with
# 413 before any handler reads it. nginx also caps the body at the edge; this is
# the defence for a deployment that exposes the API directly.
MAX_REQUEST_BODY_BYTES=1048576
# Maximum concurrent marketing-video renders per process, and how long a request
# waits for a render slot before being shed with 503 (milliseconds).
MEDIA_VIDEO_MAX_CONCURRENCY=2
MEDIA_VIDEO_QUEUE_TIMEOUT_MS=15000
# Maximum non-terminal agent tasks a single user may hold at once.
AI_AGENT_MAX_ACTIVE_TASKS_PER_USER=25
# Trusted reverse proxies in front of the API (LC-08). `0` (default) = the API
# is reached directly, so `X-Forwarded-For`/`X-Real-IP` are attacker-controlled
# and ignored; the client is the real TCP peer. Set it to the EXACT number of
# proxies YOU operate (e.g. `1` for a single nginx) so the client is read from
# the forwarded chain. It has no effect unless TRUSTED_PROXY_CIDRS lists the
# proxy networks. Raising it above the real count makes the app trust a
# client-supplied hop and reopens the spoofing hole.
TRUSTED_PROXY_HOPS=0
# Explicit allowlist of proxy networks whose X-Forwarded-For is trusted (LC-08),
# comma/space-separated CIDRs, e.g. `10.20.0.0/24,2001:db8::/32`. EMPTY by
# default: no proxy is trusted, and loopback/RFC1918/ULA are NEVER trusted
# implicitly. Fill this only with the real proxy addresses from your actual
# network layout — never guess — and keep the origin port reachable only through
# the proxy. Invalid entries are ignored (with a warning), never trust-all.
TRUSTED_PROXY_CIDRS=

# App URLs
APP_URL=http://localhost:5173
API_URL=http://localhost:3000

# AI (اختياري — لا تكلفة حتى تفعيل مزود)
# AI_PROVIDER: none | local-heuristic | openai | anthropic | noop
#   · none/local-heuristic = محرك التحليل المحلي الحقيقي (بلا تكلفة)
#   · openai / anthropic  = مزوّد خارجي (يتطلب AI_API_KEY)
AI_PROVIDER=noop
# AI_MODEL: تجاوز اختياري للطراز. لو فاضي، يستخدم الراوتر سياسة القدرة
# (capability policy) ثم AI_DEFAULT_MODEL. القيمة هنا اسم الطراز لدى المزوّد
# (مثال: gpt-4o-mini) وليس مفتاح الكتالوج (openai-gpt-4o-mini).
AI_MODEL=
AI_DEFAULT_MODEL=openai-gpt-4o-mini
AI_API_KEY=
# حد زمني صلب لكل نداء مزوّد خارجي (ملّي ثانية).
AI_REQUEST_TIMEOUT_MS=30000

# Payments — يُفعَّل مزوّد واحد فقط عبر PAYMENT_PROVIDER.
# القيم: noop | manual | open-checkout | flouci | clictopay
# لا تضع أي مفاتيح حقيقية هنا — القيم الحقيقية عبر Secrets/Environment فقط.
PAYMENT_PROVIDER=noop
# HMAC secret لتوقيع/تحقق webhooks الخاصة بـmanual/open-checkout فقط
# (Flouci وClicToPay لا يوثّقان توقيعًا — يُتحقق من الحالة مباشرة من المزوّد).
PAYMENT_WEBHOOK_SECRET=

# Flouci Payment Gateway (https://docs.flouci.com)
# مفاتيح TEST APP متاحة فورًا بعد رفع RNE؛ مفاتيح الإنتاج بعد KYB.
# المبالغ تُرسل بالمليم (minor units). المفاتيح تُقرأ من البيئة فقط.
FLOUCI_BASE_URL=https://developers.flouci.com
FLOUCI_PUBLIC_KEY=
FLOUCI_PRIVATE_KEY=

# ClicToPay (SPS Monétique Tunisie)
# الـhost والاعتمادات تُمنح من SPS/البنك.
# sandbox: https://test.clictopay.com/payment/rest
# production: https://ipay.clictopay.com/payment/rest
CLICTOPAY_BASE_URL=https://test.clictopay.com/payment/rest
CLICTOPAY_USERNAME=
CLICTOPAY_PASSWORD=

# CORS
CORS_ORIGIN=http://localhost:5173

# CSRF protection for cookie-authenticated state-changing requests
# (POST/PUT/PATCH/DELETE that carry the session cookie). `auto` (default)
# enforces it in production/staging and leaves local dev/test frictionless;
# `on`/`off` force it. Trusted origins are APP_URL plus CORS_ORIGIN entries.
CSRF_PROTECTION=auto

# Mandatory MFA for internal staff (LC-06). Staff roles — SUPPORT, RISK,
# DISPUTE, ADMIN, SUPER_ADMIN — cannot obtain a session or reach any staff API
# without an enabled second factor. `auto` (default) enforces it in production
# only, so the public demo (`NODE_ENV=staging`, published passwords) is not
# locked out; `on` forces it everywhere (tests/proof); `off` disables it.
STAFF_MFA_ENFORCEMENT=auto
# TTL (minutes) of the pending staff-enrollment challenge issued at login.
MFA_ENROLLMENT_TOKEN_TTL_MINUTES=15

# Legal acceptance gate (LC-01). Off by default, and a deliberate two-key action
# to turn on: the operator sets `on` AND a document must actually be
# published-and-in-force. Every catalogue document ships as a draft
# (LEGAL_REVIEW_REQUIRED, no effective date), so even with `on` the gate is inert
# against drafts. Switch to `on` only after qualified counsel approves the texts
# and they are published with a version and an effective date.
LEGAL_ACCEPTANCE_ENFORCEMENT=off

# Scheduler (in-process background jobs) — off by default.
# Enables subscription auto-renew rollover. Idempotent across workers, so it is
# safe if hit by both the scheduler and the admin route, or by two instances.
# Leave false in tests/one-off commands.
SCHEDULER_ENABLED=false
SUBSCRIPTION_ROLLOVER_INTERVAL_MINUTES=60

# Dispute auto-escalation sweep. When enabled, live disputes past their policy
# `autoEscalateDays` window are moved to ESCALATED. Idempotent and safe across
# instances (conditional UPDATE), so it may also be triggered by an external cron
# via POST /api/admin/disputes/escalate-overdue. Leave false in tests.
DISPUTE_ESCALATION_ENABLED=false
DISPUTE_ESCALATION_INTERVAL_MINUTES=30

# Dev-only token-surfacing routes (verification links, phone codes, reset
# tokens, TOTP). On automatically in development/test. A deployed environment
# must opt in explicitly, and only for pre-production QA: enabling it lets
# anyone who can reach the API mint tokens for any address. Refused in
# production regardless of this value.
ALLOW_DEV_TOOLING=false

# Observability (C2). Structured JSON logs go to stdout for the platform's log
# collector; `pretty` is for reading along in a terminal. The in-process buffer
# behind the admin logs route only holds records at or above OBS_LOG_LEVEL.
OBS_LOG_LEVEL=info
OBS_LOG_FORMAT=json
# Alert rule evaluation. Needs the scheduler enabled to run on an interval; it
# can also be triggered from the admin route. `log` notifier always works;
# `webhook` POSTs to OBS_ALERT_WEBHOOK_URL (Slack/PagerDuty bridge).
OBS_ALERTS_ENABLED=false
OBS_ALERT_INTERVAL_MINUTES=5
OBS_ALERT_NOTIFY=log
OBS_ALERT_WEBHOOK_URL=
OBS_ALERT_WEBHOOK_TOKEN=
# Prometheus scrape endpoint at /metrics. Set METRICS_TOKEN to require a bearer
# token; otherwise restrict the endpoint to the scraping network.
METRICS_ENABLED=true
METRICS_TOKEN=

# Read cache for hot, rarely-changing reference reads (geo catalogue,
# categories, SEO sitemap). Disabled by default: with it off every read hits the
# source, which is what tests and one-off commands want. Enable in a deployment
# to absorb repeat reads; a write invalidates the namespace it changed, so the
# TTL is only an upper bound on how long an *unwritten* change can lag.
CACHE_ENABLED=false
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRIES=500

# Mail (transactional email: email verification, password reset).
# `log` = no-network fallback for local dev/CI (a redacted line is printed and a
# MAIL.SENT audit row is written). `smtp` = real delivery.
# Credentials come only from the environment; never commit them.
MAIL_TRANSPORT=log
MAIL_FROM=WASIT BUSINESS GLOBAL <no-reply@wasit.tn>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
# SMS (phone verification). `log` = no-network fallback for dev/CI; `http` posts
# a JSON body to a gateway. Field names are configurable for the common
# `{ to, text }` providers; auth scheme may be none/bearer/basic.
SMS_TRANSPORT=log
SMS_SENDER=WASIT
SMS_HTTP_URL=
SMS_HTTP_AUTH_SCHEME=none
SMS_HTTP_TOKEN=
SMS_HTTP_USERNAME=
SMS_HTTP_PASSWORD=
SMS_HTTP_TO_FIELD=to
SMS_HTTP_TEXT_FIELD=text
SMS_HTTP_SENDER_FIELD=from
PHONE_VERIFY_TTL_MINUTES=10
PHONE_VERIFY_MAX_ATTEMPTS=5
# Media storage (marketing videos, generated assets). Assets are private: they
# are written to storage under opaque keys and served only via signed,
# short-lived API links — never as static files. `local` is the on-disk driver.
MEDIA_STORAGE=local
MEDIA_STORAGE_DIR=.wasit-media
# Public origin used to build preview URLs in JSON responses (empty = relative).
PUBLIC_API_URL=
# Marketing video renderer. `structural` = real local MP4 render via
# ffmpeg-static + libass (Arabic shaping supported). `noop` fails loudly.
VIDEO_PROVIDER=structural
VIDEO_FFMPEG_PATH=
VIDEO_WIDTH=720
VIDEO_HEIGHT=1280
VIDEO_FPS=25
VIDEO_FONT=DejaVu Sans
VIDEO_ARABIC_FONT=Noto Sans Arabic
VIDEO_FONTS_DIR=
MEDIA_DOWNLOAD_TTL_SECONDS=900
MEDIA_MAX_VIDEO_BYTES=52428800
