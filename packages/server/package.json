{
  "name": "@wasit/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "build:prod": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --external:argon2 --outfile=dist-bundle/index.cjs && esbuild src/scripts/seed.ts --bundle --platform=node --format=cjs --target=node20 --external:argon2 --outfile=dist-bundle/seed.cjs && esbuild src/scripts/seed-demo.ts --bundle --platform=node --format=cjs --target=node20 --external:argon2 --outfile=dist-bundle/seed-demo.cjs",
    "seed:prod": "node dist-bundle/seed.cjs",
    "start:prod": "node dist-bundle/index.cjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:seed:demo": "tsx src/scripts/seed-demo.ts",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "load:smoke": "tsx src/scripts/load-smoke.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@wasit/shared": "*",
    "argon2": "^0.41.0",
    "cookie": "^1.0.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.36.0",
    "ffmpeg-static": "^5.3.0",
    "hono": "^4.6.0",
    "nodemailer": "^6.10.1",
    "pg": "^8.13.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/decimal.js": "^0.0.32",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^6.4.24",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.28.0",
    "esbuild": "^0.24.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
